FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     afsdFoam;

startFrom       latestTime;
startTime       0;
stopAt          endTime;
endTime         25;

deltaT          1e-4;
adjustTimeStep  yes;
maxCo           0.25;       // tesis cap. 3
maxDi           10;
maxDeltaT       0.005;

writeControl    adjustable;
writeInterval   1;          // debe dividir 25 y 35 (cambios de fase)
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable yes;

functions
{
    // Volumen de metal en build [m3] (desactivado en el dwell: no hay build)
    metalVolume
    {
        type            volFieldValue;
        libs            (fieldFunctionObjects);
        region          build;
        fields          (alpha.metal);
        operation       volIntegrate;
        regionType      all;
        writeFields     false;
        writeControl    timeStep;
        writeInterval   1;
        log             false;
    }

    // Sondas en el sustrato para los termopares (las genera termopares.py)
    #include "thermocouples"
}

