FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      regionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Modelo completo (fases 2 y 3: fill y avance)
regions
(
    fluid       (build)
    solid       (substrate anvil)
);

