FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      regionProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Fase 1 (dwell): solo los sólidos, como en la tesis cap. 4
regions
(
    fluid       ()
    solid       (substrate anvil)
);

