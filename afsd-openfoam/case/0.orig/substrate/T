FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/substrate";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    // Laterales y fondo: convección h = 10 W/m2K (tesis, cap. 2)
    ".*"
    {
        type            externalWallHeatFluxTemperature;
        mode            coefficient;
        h               uniform 10;
        Ta              constant 300;
        kappaMethod     solidThermo;
        value           $internalField;
    }

    // Marco de la herramienta: el sólido entra por x = +L/2 a temperatura
    // ambiente y sale por x = -L/2
    substrate_front
    {
        type            fixedValue;
        value           uniform 300;
    }

    substrate_back
    {
        type            zeroGradient;
    }

    // Interfaces: continuidad de T y de flujo de calor
    "substrate_to_.*"
    {
        type            compressible::turbulentTemperatureCoupledBaffleMixed;
        Tnbr            T;
        kappaMethod     solidThermo;
        value           $internalField;
    }
}

