FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0/build";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Herramienta y barra: fixedValue con valores que fija el solver en cada
// paso (ec. 12-13, constant/build/toolProperties). Los "value" de aquí
// son solo iniciales.

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    // Atmósfera (tesis: inlet-outlet)
    "build_(top|sides|front|back)"
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    // Superficie del sustrato: no deslizamiento, se mueve a -Vt
    // (mantener igual que constant/frameProperties)
    "build_to_.*"
    {
        type            fixedValue;
        value           uniform (-0.00212 0 0);
    }

    "tool(Face|Side)"
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    inlet
    {
        type            fixedValue;
        value           uniform (0 0 -0.00212);
    }
}

